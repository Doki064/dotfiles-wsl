# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Load options
source "$ZDOTDIR/.options"

# Load functions
source "$ZDOTDIR/.functions"

# Load aliases
source "$ZDOTDIR/.aliases"

# Load Zi
if [[ ! -f $HOME/.zi/bin/zi.zsh ]]; then
  print -P "%F{33}▓▒░ %F{160}Installing (%F{33}z-shell/zi%F{160})…%f"
  command mkdir -p "$HOME/.zi" && command chmod go-rwX "$HOME/.zi"
  command git clone -q --depth=1 --branch "main" https://github.com/z-shell/zi "$HOME/.zi/bin" && \
    print -P "%F{33}▓▒░ %F{34}Installation successful.%f%b" || \
    print -P "%F{160}▓▒░ The clone has failed.%f%b"
fi
source "$HOME/.zi/bin/zi.zsh"

autoload -Uz _zi
(( ${+_comps} )) && _comps[zi]=_zi

# Load a few important annexes, without Turbo
# (this is currently required for annexes)
zi light-mode for \
    z-shell/z-a-meta-plugins \
    @annexes \
    @romkatv

# Load theme and plugins without Turbo
zi for \
    agkozak/zsh-z

# Load a few useful plugins for zsh with Turbo
zi wait lucid for \
    OMZP::colored-man-pages \
    OMZP::command-not-found \
    OMZP::sudo \
    OMZL::git.zsh

zi wait"1a" lucid reset \
    atclone"[[ -z ${commands[dircolors]} ]] && local P=g
        \${P}sed -i '/DIR/c\DIR 38;5;63;1' LS_COLORS; \
        \${P}dircolors -b LS_COLORS > clrs.zsh" \
    atpull'%atclone' pick"clrs.zsh" nocompile'!' \
    atload'zstyle ":completion:*" list-colors "${(s.:.)LS_COLORS}"' for \
        trapd00r/LS_COLORS

zi wait"2b" lucid light-mode for \
    Aloxaf/fzf-tab

zi wait lucid light-mode for \
    z-shell/H-S-MW \
    atinit"ZI[COMPINIT_OPTS]=-C; zicompinit; zicdreplay" \
        z-shell/F-Sy-H \
    atload"_zsh_autosuggest_start" \
        zsh-users/zsh-autosuggestions \
    blockf atpull'zi creinstall -q .' \
        zsh-users/zsh-completions

# ### End of Zi's installer chunk

# Load colors
autoload -U colors
colors

autoload -U bashcompinit
bashcompinit

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# bun completions
[ -s "/home/minhd/.bun/_bun" ] && source "/home/minhd/.bun/_bun"

# Activate mise (installs and versions cli tools: eza, fd, ...)
command -v mise >/dev/null && eval "$(mise activate zsh)"
